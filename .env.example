# Stage 1 environment variables.
# Kafka connection settings are added in Milestone 5 once the relay exists.

NODE_ENV=development

# PostgreSQL (see docker-compose.yml)
POSTGRES_USER=eventpulse
POSTGRES_PASSWORD=eventpulse
POSTGRES_DB=eventpulse
POSTGRES_PORT=5432

# Used by Prisma (packages/database) and, from Milestone 4, the API.
DATABASE_URL=postgresql://eventpulse:eventpulse@localhost:5432/eventpulse?schema=public
